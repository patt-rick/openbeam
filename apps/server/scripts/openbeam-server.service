[Unit]
Description=OpenBeam server (Axum, Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__SERVER_DIR__
EnvironmentFile=/etc/openbeam.env
ExecStart=__SERVER_DIR__/target/release/openbeam-server
Restart=on-failure
RestartSec=5s
# 24GB on Ampere A1 is plenty; cap at 4GB to leave room for anything else.
MemoryHigh=3G
MemoryMax=4G
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
