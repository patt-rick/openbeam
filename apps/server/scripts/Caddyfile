# Caddy reverse proxy for openbeam-server.
# __HOSTNAME__ is substituted by oci-bootstrap.sh — defaults to a
# sslip.io name derived from the VM's public IP (e.g. 1-2-3-4.sslip.io)
# so you don't need to own a domain. Override by exporting
# OPENBEAM_HOSTNAME=your.domain.example before running the bootstrap.
# Caddy auto-issues a Let's Encrypt cert once TCP 80/443 are reachable.
__HOSTNAME__ {
	encode zstd gzip

	# WebSocket-friendly reverse proxy. Caddy handles Upgrade/Connection
	# headers automatically; no extra config needed for /ws/* paths.
	reverse_proxy 127.0.0.1:4001

	log {
		output file /var/log/caddy/openbeam-api.log
		format console
	}
}
